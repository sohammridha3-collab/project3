# =============================================================================
# ScamShield AI — Environment Configuration Template (.env.example)
# Rename this file to .env and configure your production values.
# NEVER commit real secret keys or production database credentials to git.
# =============================================================================

# Server Environment & Network Configuration
ENVIRONMENT=production
DEBUG=false
HOST=0.0.0.0
PORT=8001

# Machine Learning Pipeline Path
# Relative or absolute path to the scikit-learn trained joblib/pickle pipeline
MODEL_PATH=scam_detection_pipeline.pkl
# Optional remote download URL if the model is stored on S3/R2/HuggingFace:
# MODEL_DOWNLOAD_URL=https://your-bucket.r2.cloudflarestorage.com/scam_detection_pipeline.pkl

# Database Connection
# Default SQLite local database (ephemeral on free PaaS without persistent disk):
DATABASE_URL=sqlite:///./scamshield.db
# For production PostgreSQL (Supabase, Neon, Render Postgres, Railway Postgres):
# DATABASE_URL=postgresql://username:password@db.supabase.co:5432/postgres

# Authentication & Security
# Generate a secure 32+ character key using: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change_this_to_a_random_super_secret_key_at_least_32_characters_long
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Allowed CORS Origins (Comma-separated list or * for universal access)
# If frontend and backend are deployed separately (e.g. Netlify/Vercel -> Render backend):
# CORS_ORIGINS=https://your-frontend.vercel.app,https://your-frontend.netlify.app
# If frontend and backend are unified on Render/Railway, CORS is automatically handled.
CORS_ORIGINS=*
